ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080

POSTGRES_PORT=5433
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music_anti_blur

ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=music_anti_blur;Username=music;Password=music
ConnectionStrings__Redis=localhost:6379
ConnectionStrings__Hangfire=Host=localhost;Port=5433;Database=music_anti_blur;Username=music;Password=music

Jwt__Issuer=music-anti-blur
Jwt__Audience=music-anti-blur
Jwt__Key=dev-only-change-me-use-at-least-32-chars!!

# MailHog: no login, no TLS. Letters stay on this machine.
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=noreply@localhost
Smtp__Security=None
# Smtp__User=
# Smtp__Password=
# Smtp__FromName=

# Personal mailbox. From must equal User. Use an app password.
# Smtp__Host=smtp.yandex.ru
# Smtp__Port=465
# Smtp__Security=SslOnConnect
# Smtp__User=owner@yandex.ru
# Smtp__Password=
# Smtp__From=owner@yandex.ru

# Dedicated relay.
# Smtp__Host=smtp.example.com
# Smtp__Port=587
# Smtp__Security=StartTls
# Smtp__User=
# Smtp__Password=
# Smtp__From=noreply@example.com

Hangfire__DashboardUser=admin
Hangfire__DashboardPassword=admin-local-only

Seed__AdminIdentifierType=login
Seed__AdminIdentifier=admin
Seed__AdminPassword=AdminPassword123

App__PublicBaseUrl=http://localhost:5080
App__DeepLinkScheme=musicantiblur

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-local-only
MINIO_BUCKET=music-anti-blur
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

Storage__Endpoint=http://127.0.0.1:9000
Storage__PresignEndpoint=
Storage__Region=us-east-1
Storage__Bucket=music-anti-blur
Storage__AccessKey=minio
Storage__SecretKey=minio-local-only
Storage__ForcePathStyle=true
Storage__UseCdn=false
Storage__CatalogMaxSourceBytes=104857600
# Private upload quota per user (defaults: 2 GiB, 500 files). Admin can override per user.
Storage__PrivateQuotaBytes=2147483648
Storage__PrivateQuotaFiles=500
# Web admin: origins allowed to call the API from a browser (comma-separated). Development always allows loopback.
Cors__AllowedOrigins=
# Days a soft-deleted track stays restorable before the purge job removes it and its files.
Catalog__DeletedRetentionDays=180
Cdn__BaseUrl=
Cdn__SecureTokenKey=
Cdn__UrlTtlSeconds=600
Cdn__CacheTtlSeconds=480
Media__FfmpegPath=ffmpeg
Media__FfprobePath=ffprobe

# Observability (docker compose profile "observability"). Details: docs/05-local-setup.md §8
# COMPOSE_PROFILES=observability
Loki__Url=
# Bearer token for GET /metrics. Empty = open in Development only, 404 elsewhere.
Metrics__ScrapeToken=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-local-only
GRAFANA_PUBLIC_URL=http://localhost:3000
ALERT_EMAIL_TO=ops@music-anti-blur.local
# Grafana SMTP. Default is MailHog inside compose.
GRAFANA_SMTP_HOST=mailhog:1025
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=alerts@music-anti-blur.local
GRAFANA_SMTP_STARTTLS_POLICY=NoStartTLS

# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs). Empty = ignore the header.
ForwardedHeaders__KnownProxies=

# Внешний адрес API для https-ссылок /s/{type}/{id}; пусто - берётся из запроса
Sharing__PublicBaseUrl=
