ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080

# Host port for compose Postgres. Change if 5432 is already taken.
POSTGRES_PORT=5432
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music_anti_blur

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=music_anti_blur;Username=music;Password=music
ConnectionStrings__Redis=localhost:6379
ConnectionStrings__Hangfire=Host=localhost;Port=5432;Database=music_anti_blur;Username=music;Password=music

Jwt__Issuer=music-anti-blur
Jwt__Audience=music-anti-blur
Jwt__Key=dev-only-change-me-use-at-least-32-chars!!

Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=noreply@localhost

Hangfire__DashboardUser=admin
Hangfire__DashboardPassword=admin-local-only

Seed__AdminIdentifierType=login
Seed__AdminIdentifier=admin
Seed__AdminPassword=AdminPassword123

App__PublicBaseUrl=http://localhost:5080
App__DeepLinkScheme=musicantiblur

# Local Object Storage (MinIO-compatible S3 in compose, image pgsty/minio). Console: http://127.0.0.1:9001
# Production later: Yandex — devops/yandex-storage-cdn.md
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-local-only
MINIO_BUCKET=music-anti-blur
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

Storage__Endpoint=http://127.0.0.1:9000
# Host inside signed GET URLs. Empty = Storage__Endpoint.
# Android emulator: http://10.0.2.2:9000  Windows desktop Flutter: leave empty.
# Do not rewrite the hostname on the client after signing.
Storage__PresignEndpoint=
Storage__Region=us-east-1
Storage__Bucket=music-anti-blur
Storage__AccessKey=minio
Storage__SecretKey=minio-local-only
Storage__ForcePathStyle=true
Storage__UseCdn=false
Storage__CatalogMaxSourceBytes=104857600
Cdn__BaseUrl=
Cdn__SecureTokenKey=
Cdn__UrlTtlSeconds=600
Cdn__CacheTtlSeconds=480
Media__FfmpegPath=ffmpeg
Media__FfprobePath=ffprobe

